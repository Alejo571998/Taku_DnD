{
  "name": "taku-dnd",
  "version": "0.1.0",
  "private": true,
  "description": "D&D Companion — compañero digital de Dungeons & Dragons. PWA offline-first.",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:db": "node scripts/run-db-tests.mjs",
    "test:db:remote": "node scripts/run-db-tests.mjs --remote",
    "db:migrate": "node scripts/apply-migrations.mjs",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run test:db",
    "build:content": "node scripts/build-content.mjs",
    "prebuild": "node scripts/build-content.mjs && node scripts/build-taku-assets.mjs",
    "build:taku": "node scripts/build-taku-assets.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-tooltip": "1.2.16",
    "@supabase/supabase-js": "2.116.0",
    "clsx": "2.1.1",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "lucide-react": "1.46.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "uuid": "14.0.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "1.63.0",
    "@serwist/next": "9.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.3",
    "@types/pg": "^8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "pg": "^8.23.0",
    "serwist": "9.5.12",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
